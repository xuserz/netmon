[Unit]
Description=Lightweight network activity monitor
Documentation=file:/usr/share/doc/netmon/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=netmon
Group=netmon
ExecStartPre=/usr/local/bin/netmon --config /etc/netmon/config.yaml check --startup
ExecStart=/usr/local/bin/netmon --config /etc/netmon/config.yaml run
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
StateDirectory=netmon
StateDirectoryMode=0750
RuntimeDirectory=netmon
RuntimeDirectoryMode=0750
UMask=0027
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_PACKET AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Host network namespace is required. Do not set PrivateNetwork=yes.

[Install]
WantedBy=multi-user.target
